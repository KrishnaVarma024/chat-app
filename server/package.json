{
  "name": "chat-app-server",
  "version": "0.1.0",
  "private": true,
  "description": "Polling-based chat API. See /ARCHITECTURE.md and /ROADMAP.md at the repo root.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "migrate:up": "node-pg-migrate up --envPath .env",
    "migrate:down": "node-pg-migrate down --envPath .env",
    "migrate:create": "node-pg-migrate create --envPath .env",
    "migrate:up:prod": "node-pg-migrate up",
    "seed": "tsx src/db/seed.ts",
    "build": "tsc",
    "start": "npm run migrate:up:prod && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:concurrency": "node scripts/concurrency-test.mjs",
    "test:scrollback-stability": "node scripts/scrollback-stability-test.mjs",
    "test:hardening": "node scripts/hardening-test.mjs",
    "test:refresh-race": "node scripts/refresh-race-test.mjs",
    "test:register-race": "node scripts/register-race-test.mjs",
    "test:leave-race": "node scripts/leave-race-test.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
