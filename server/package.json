{
  "name": "chat-app-server",
  "version": "0.1.0",
  "private": true,
  "description": "Polling-based chat API. See /ARCHITECTURE.md and /ROADMAP.md at the repo root.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "migrate:up": "node-pg-migrate up --envPath .env",
    "migrate:down": "node-pg-migrate down --envPath .env",
    "migrate:create": "node-pg-migrate create --envPath .env",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test:concurrency": "node scripts/concurrency-test.mjs",
    "test:scrollback-stability": "node scripts/scrollback-stability-test.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
