DATABASE_URL=postgresql://chatapp:chatapp@localhost:5432/chatapp
NODE_ENV=development
PORT=4000

# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
ACCESS_TOKEN_TTL=15m

# The origin the React client runs on — must be exact (no wildcard) since
# the refresh flow relies on a credentialed (httpOnly cookie) CORS request.
CORS_ORIGIN=http://localhost:5173
